{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build -- --outDir dist --emptyOutDir",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/v1/api/:path*",
      "destination": "https://circuitsim.enjoys.in/v1/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}