# Application
APP_NAME="CircuitSim API"
ENVIRONMENT="development"
API_V1_PREFIX="/v1/api"

# Postgres (durable store)
POSTGRES_DSN="postgresql+asyncpg://postgres:postgres@localhost:5432/circuitsim"

# Realtime fast store (local SQLite buffer)
REALTIME_DB_PATH="./data/realtime.db"
REALTIME_FLUSH_INTERVAL="3.0"

# Static frontend build served at "/"
STATIC_DIR="dist"

# CORS
CORS_ORIGINS='["*"]'

# Local-network access (agent reachable beyond localhost)
# When LAN_ENABLED is true and PAIRING_TOKEN is set, non-local clients must
# send header:  X-CircuitSim-Token: <token>
LAN_ENABLED="false"
PAIRING_TOKEN=""

# AI assistant (optional). Add at least one provider key to enable the in-app
# assistant. AI_PROVIDER picks which one; "auto" prefers the first key found in
# this order: groq, gemini, mistral, openrouter, openai, anthropic, nvidia.
# AI_MODEL overrides the active provider's default model (leave blank to use it).
AI_PROVIDER="auto"
AI_MODEL=""

# Groq (free, fast) — https://console.groq.com/keys
GROQ_API_KEY=""
# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""
# OpenRouter (many free models) — https://openrouter.ai/keys
OPEN_ROUTER_KEY=""
# NVIDIA NIM — https://build.nvidia.com (noted as slow)
NVIDIA_API_KEY=""
# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
